# ======================================================================
# GEM GUJARAT — PRODUCTION APACHE SERVER CONFIGURATION (.htaccess)
# ======================================================================

# ----------------------------------------------------------------------
# 1. SECURITY & CORE SETTINGS
# ----------------------------------------------------------------------
# Prevent directory browsing
Options -Indexes

# Hide server version and OS details
ServerSignature Off

# Disable ETags (Performance improvement, saves bandwidth)
FileETag None

# Default charset
AddDefaultCharset UTF-8

# Block access to hidden files and directories (e.g. .git, .env)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block access to sensitive file extensions
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op]|env|ini|yml|yaml)|~)$">
    Require all denied
</FilesMatch>

# Block direct web access to internal PHP libraries and includes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|phpmailer)/ - [F,L]
</IfModule>

# ----------------------------------------------------------------------
# 2. SECURITY HEADERS
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # HSTS (Force HTTPS for 1 year with subdomains and preload)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # Clickjacking protection
    Header always append X-Frame-Options SAMEORIGIN

    # Prevent MIME-sniffing
    Header set X-Content-Type-Options nosniff

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy (Restrict camera, microphone, geolocation)
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Allow font and asset sharing (CORS for Web Fonts & Icons)
    <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|svg)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# 3. MIME TYPES
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
    # Web fonts
    AddType font/woff                           woff
    AddType font/woff2                          woff2
    AddType font/ttf                            ttf
    AddType font/otf                            otf
    AddType application/vnd.ms-fontobject        eot

    # Modern image formats
    AddType image/webp                          webp
    AddType image/avif                          avif
    AddType image/svg+xml                       svg svgz

    # Web App Manifest
    AddType application/manifest+json           webmanifest
    AddType application/json                    json
</IfModule>

# ----------------------------------------------------------------------
# 4. URL REWRITING & CANONICALIZATION
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 4.1 Force HTTPS (Exclude localhost / 127.0.0.1 for local development)
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 4.2 Force WWW for production domain (Exclude localhost)
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 4.3 Redirect /index.php to root URL (SEO canonicalization)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*index\.php [NC]
    RewriteRule ^(([^/]+/)*)index\.php$ /$1 [R=301,L]

    # 4.4 Remove multiple consecutive slashes
    RewriteCond %{THE_REQUEST} //+
    RewriteRule ^(.*) /$1 [R=301,L]
</IfModule>

# ----------------------------------------------------------------------
# 5. BOT BLOCKING & CRAWLER PROTECTION
# ----------------------------------------------------------------------
<IfModule mod_setenvif.c>
    SetEnvIfNoCase User-Agent ^$ bad_bot
    SetEnvIfNoCase User-Agent "Baiduspider" bad_bot
    SetEnvIfNoCase User-Agent "MJ12bot" bad_bot
    SetEnvIfNoCase User-Agent "AhrefsBot" bad_bot
    SetEnvIfNoCase User-Agent "SemrushBot" bad_bot
    SetEnvIfNoCase User-Agent "DotBot" bad_bot
    SetEnvIfNoCase User-Agent "Sogou" bad_bot
    SetEnvIfNoCase User-Agent "Exabot" bad_bot
    SetEnvIfNoCase User-Agent "BlexBot" bad_bot
    SetEnvIfNoCase User-Agent "spbot" bad_bot

    <RequireAll>
        Require all granted
        Require not env bad_bot
    </RequireAll>
</IfModule>

# ----------------------------------------------------------------------
# 6. GZIP / DEFLATE COMPRESSION
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>

# ----------------------------------------------------------------------
# 7. BROWSER CACHING (Expires & Cache-Control)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Dynamic HTML Content (Always revalidate for fresh content)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS and JavaScript (Cached for 1 year)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Images (Cached for 1 year)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Web Fonts (Cached for 1 year)
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

    # Sitemaps & XML Feeds (Cached for 1 hour)
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/xml "access plus 1 hour"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    # Static Assets (Images, Fonts, CSS, JS)
    <FilesMatch "\.(js|css|jpg|jpeg|png|gif|webp|avif|ico|svg|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Sitemaps & Robots
    <FilesMatch "\.(xml|txt)$">
        Header set Cache-Control "max-age=3600, public"
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# 8. CUSTOM ERROR PAGES
# ----------------------------------------------------------------------
ErrorDocument 404 /404.php